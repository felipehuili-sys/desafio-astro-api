---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';

// 1. Interface para tipar la respuesta de la API
interface Product {
  id: number;
  title: string;
  description: string;
  price: number;
  rating: number;
  category: string;
  thumbnail: string;
}

// 2. Consumo de la API DummyJSON con fetch()
const response = await fetch('https://dummyjson.com/products?limit=30');
const data = await response.json();
const products: Product[] = data.products;
---

<Layout title="Catálogo de Productos - API DummyJSON">
  <Header 
    title="🛒 Catálogo de Productos Astro" 
    subtitle="Explora nuestra selección traída en tiempo real desde DummyJSON" 
  />

  <main class="container">
    <!-- Buscador interactivo -->
    <section class="search-section">
      <div class="search-box">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Buscar por nombre, categoría o descripción..." 
          autocomplete="off"
        />
        <span class="search-icon">🔍</span>
      </div>
      <p id="search-counter" class="search-counter">
        Mostrando {products.length} productos
      </p>
    </section>

    <!-- Presentación con CSS Grid -->
    <section class="products-grid" id="products-grid">
      {products.map((product) => (
        <ProductCard
          id={product.id}
          title={product.title}
          description={product.description}
          price={product.price}
          rating={product.rating}
          category={product.category}
          thumbnail={product.thumbnail}
        />
      ))}
    </section>

    <!-- Mensaje cuando no hay coincidencias -->
    <div id="no-results" class="no-results hidden">
      <p>❌ No se encontraron productos que coincidan con tu búsqueda.</p>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .search-section {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .search-box {
    position: relative;
    width: 100%;
    max-width: 600px;
  }

  .search-box input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.8rem;
    font-size: 1rem;
    border: 2px solid var(--border-color);
    border-radius: 30px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    background-color: #fff;
  }

  .search-box input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.1rem;
    opacity: 0.6;
    pointer-events: none;
  }

  .search-counter {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Implementación Requerida: CSS Grid Responsive */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  .no-results {
    text-align: center;
    padding: 3rem 1rem;
    background-color: white;
    border-radius: var(--radius);
    border: 1px dashed var(--border-color);
    margin-top: 1rem;
  }

  .no-results p {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .hidden {
    display: none !important;
  }

  /* Adaptación a pantallas pequeñas */
  @media (max-width: 600px) {
    .products-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .container {
      padding: 0 1rem;
    }
  }
</style>

<script>
  // Buscador funcional en el cliente (JavaScript Vanilla)
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const productCards = document.querySelectorAll<HTMLElement>('.product-card');
    const noResultsMsg = document.getElementById('no-results');
    const searchCounter = document.getElementById('search-counter');

    if (!searchInput) return;

    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let visibleCount = 0;

      productCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';
        const category = card.getAttribute('data-category') || '';

        const matches = title.includes(query) || description.includes(query) || category.includes(query);

        if (matches) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Actualizar contador de resultados
      if (searchCounter) {
        searchCounter.textContent = `Mostrando ${visibleCount} producto${visibleCount === 1 ? '' : 's'}`;
      }

      // Mostrar/ocultar mensaje sin resultados
      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    });
  });
</script>