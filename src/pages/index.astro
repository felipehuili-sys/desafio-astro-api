---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';

// 1. Interface para tipar la respuesta de la API
interface Product {
  id: number;
  title: string;
  description: string;
  price: number;
  rating: number;
  category: string;
  thumbnail: string;
}

// 2. Consumo de la API DummyJSON con fetch()
const response = await fetch('https://dummyjson.com/products?limit=30');
const data = await response.json();
const products: Product[] = data.products;
---

<Layout title="Catálogo de Productos - API DummyJSON">
  <Header 
    title="🛒 Catálogo de Productos Astro" 
    subtitle="Explora nuestra selección traída en tiempo real desde DummyJSON" 
  />

  <main class="container">
    <!-- Buscador interactivo -->
    <section class="search-section">
      <div class="search-box">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Buscar por nombre, categoría o descripción..." 
          autocomplete="off"
        />
        <span class="search-icon">🔍</span>
        <label class="category-filter" for="category-filter" aria-label="Filtrar por categoría">
          <select id="category-filter">
            <option value="all">Todas</option>
            {Array.from(new Set(products.map((product) => product.category))).sort().map((category) => (
              <option value={category.toLowerCase()}>{category}</option>
            ))}
          </select>
        </label>
      </div>
      <p id="search-counter" class="search-counter">
        Mostrando {products.length} productos
      </p>
    </section>

    <!-- Presentación con CSS Grid -->
    <section class="products-grid" id="products-grid">
      {products.map((product) => (
        <ProductCard
          id={product.id}
          title={product.title}
          description={product.description}
          price={product.price}
          rating={product.rating}
          category={product.category}
          thumbnail={product.thumbnail}
        />
      ))}
    </section>

    <!-- Mensaje cuando no hay coincidencias -->
    <div id="no-results" class="no-results hidden">
      <p>❌ No se encontraron productos que coincidan con tu búsqueda.</p>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .search-section {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 600px;
    padding-right: 0.5rem;
    border: 2px solid var(--border-color);
    border-radius: 30px;
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
  }

  .search-box input {
    min-width: 0;
    flex: 1;
    padding: 0.85rem 0.5rem 0.85rem 2.8rem;
    font-size: 1rem;
    border: 0;
    border-radius: 30px;
    outline: none;
    background-color: transparent;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.1rem;
    opacity: 0.6;
    pointer-events: none;
  }

  .search-counter {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Implementación Requerida: CSS Grid Responsive */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  .no-results {
    text-align: center;
    padding: 3rem 1rem;
    background-color: white;
    border-radius: var(--radius);
    border: 1px dashed var(--border-color);
    margin-top: 1rem;
  }

  .no-results p {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  :global(.hidden) {
    display: none !important;
  }

  /* Adaptación a pantallas pequeñas */
  @media (max-width: 600px) {
    .products-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .container {
      padding: 0 1rem;
    }
  }
</style>

<script>
  // Buscador funcional en el cliente (JavaScript Vanilla)
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
    const productCards = document.querySelectorAll<HTMLElement>('.product-card');
    const noResultsMsg = document.getElementById('no-results');
    const searchCounter = document.getElementById('search-counter');

    if (!searchInput || !categoryFilter) return;

    const filterProducts = () => {
      const query = searchInput.value.trim().toLocaleLowerCase();
      const selectedCategory = categoryFilter.value;
      let visibleCount = 0;

      productCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';
        const category = card.getAttribute('data-category') || '';
        const matchesText = (title + ' ' + description + ' ' + category).includes(query);
        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matches = matchesText && matchesCategory;

        card.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
      });

      if (searchCounter) {
        searchCounter.textContent = 'Mostrando ' + visibleCount + ' producto' + (visibleCount === 1 ? '' : 's');
      }
      noResultsMsg?.classList.toggle('hidden', visibleCount !== 0);
    };

    searchInput.addEventListener('input', filterProducts);
    categoryFilter.addEventListener('change', filterProducts);
  });
</script>